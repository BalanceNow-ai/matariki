# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# Signal K Webhook - Secret token for authenticating position updates from Cerbo GX.
# Also authenticates the admin endpoints (import, export, clear, migrate) and
# /admin/import. Without it those endpoints refuse all requests.
# Generate with: openssl rand -hex 32
SIGNALK_WEBHOOK_SECRET=

# Durable position storage (Neon Postgres). Without this the track lives only in
# Redis, where it is subject to eviction.
DATABASE_URL=

# Recent-position cache and request log (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tracking alerts. The cron posts here when the vessel stops reporting or
# loses its GPS fix, once more if it is still broken 24h later, and once again
# when it recovers - not on every run.
#
# The request format is detected from the URL:
#   https://ntfy.sh/<your-random-topic>          no account needed
#   https://discord.com/api/webhooks/<id>/<tok>  Discord
#   https://hooks.slack.com/services/...         Slack
# Anything else receives generic JSON.
ALERT_WEBHOOK_URL=

# Only needed for a self-hosted ntfy, whose hostname cannot be recognised.
# One of: ntfy | slack | discord | json
ALERT_WEBHOOK_FORMAT=

# Protects the cron endpoint (/api/position/monitor) from being triggered
# by anyone. Vercel sends this as a Bearer token on scheduled invocations.
CRON_SECRET=

# Email (Buttondown) - Get your API key at https://buttondown.email/settings#api
BUTTONDOWN_API_KEY=

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
