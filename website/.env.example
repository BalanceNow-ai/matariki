# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# Signal K Webhook - Secret token for authenticating position updates from Cerbo GX.
# Also authenticates the admin endpoints (import, export, clear, migrate) and
# /admin/import. Without it those endpoints refuse all requests.
# Generate with: openssl rand -hex 32
SIGNALK_WEBHOOK_SECRET=

# Durable position storage (Neon Postgres). Without this the track lives only in
# Redis, where it is subject to eviction.
DATABASE_URL=

# Recent-position cache and request log (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tracking alerts. The cron posts here when the vessel stops reporting or
# loses its GPS fix, once more if it is still broken 24h later, and once again
# when it recovers - not on every run.
#
# The request format is detected from the URL:
#   https://ntfy.sh/<your-random-topic>          no account needed
#   https://discord.com/api/webhooks/<id>/<tok>  Discord
#   https://hooks.slack.com/services/...         Slack
# Anything else receives generic JSON.
ALERT_WEBHOOK_URL=

# Only needed for a self-hosted ntfy, whose hostname cannot be recognised.
# One of: ntfy | slack | discord | json
ALERT_WEBHOOK_FORMAT=

# Protects the cron endpoint (/api/position/monitor) from being triggered
# by anyone. Vercel sends this as a Bearer token on scheduled invocations.
CRON_SECRET=

# Email (Buttondown) - Get your API key at https://buttondown.email/settings#api
BUTTONDOWN_API_KEY=

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Crew applications (/crew) ────────────────────────────────────────────────
# All of these are server-only except the NEXT_PUBLIC_ ones. Never prefix a
# secret with NEXT_PUBLIC_.

# Which model runs the crew interview: "gemini" (default, Gemini 4 Argon,
# model gemini-4-argon) or "anthropic" (claude-sonnet-5-5). Anything else is
# an error. Switching needs only this variable and the matching key below.
CREW_INTERVIEW_PROVIDER=gemini

# Gemini API key (aistudio.google.com) for the interview when the provider is
# "gemini". Server-only.
GEMINI_API_KEY=

# Claude API key (console.anthropic.com) for the interview when the provider
# is "anthropic". Server-only.
ANTHROPIC_API_KEY=

# Editor token scoped to the PRIVATE `crew` dataset (sanity.io/manage → API →
# Tokens). Used only server-side to write and read applications.
SANITY_CREW_WRITE_TOKEN=
# Name of the private dataset holding applications. Must not be `production`.
SANITY_CREW_DATASET=crew
# Same value, read by the Studio's "Crew applications" workspace at /studio/crew.
NEXT_PUBLIC_SANITY_CREW_DATASET=crew

# Vercel Blob read-write token for a PRIVATE store (CV uploads). Added
# automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (bot check on the application form and CV upload).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Rate limiting reuses UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN above.
# Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN also work if those are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signs applicant session tokens (2 h) and salts the stored IP hash.
# At least 32 characters. Generate with: openssl rand -hex 32
CREW_SESSION_SECRET=

# Bearer token for the admin MCP server (/api/mcp) and CV downloads
# (/api/crew/cv/[id]). At least 32 characters: openssl rand -hex 32
CREW_ADMIN_TOKEN=

# Resend (resend.com) for the "new application" email to Greg and the
# applicant's acknowledgement. The sending domain must be verified in Resend.
RESEND_API_KEY=
CREW_NOTIFY_EMAIL=
# Optional sender; defaults to "Matariki III <crew@matarikiyacht.com>".
CREW_EMAIL_FROM=

# Where applicants send privacy requests (access/deletion), shown in the
# privacy note on /crew. An email address (rendered as a mailto link) or a
# URL. Server-side only. Unset shows "[PLACEHOLDER] contact address".
CREW_PRIVACY_CONTACT=

# Makes the crew feature public. Unset or "false" (the default): /crew and
# /crew/apply still work by direct URL but are noindex/nofollow, and the
# "Apply to crew" links on /crew-info and the crew brief are hidden. "true":
# everything is shown. Server-only; takes effect on the next deployment.
CREW_PAGE_PUBLIC=false

# Kill switch for the AI interview. When "false", applications skip the
# interview, go straight to `submitted` and Greg is emailed as usual.
CREW_INTERVIEW_ENABLED=true

# CRON_SECRET (above) also protects /api/cron/crew-purge, the daily job that
# deletes applications and CVs past their deleteAfter date.
